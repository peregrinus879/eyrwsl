# Editor
export EDITOR="${EDITOR:-nvim}"
export SUDO_EDITOR="$EDITOR"

# Tools
export BAT_THEME=ansi
export MANROFFOPT="-c"
export MANPAGER="sh -c 'col -bx | bat -l man -p'"

# Login shells load /etc/locale.conf through /etc/profile.d/locale.sh. Mirror
# that fallback for SSH and Herdr sessions that start non-login shells.
if [[ -z ${LANG:-} ]]; then
  [[ -r /etc/locale.conf ]] && source /etc/locale.conf
  LANG="${LANG:-C.UTF-8}"
  export LANG LANGUAGE LC_CTYPE LC_NUMERIC LC_TIME LC_COLLATE LC_MONETARY \
    LC_MESSAGES LC_PAPER LC_NAME LC_ADDRESS LC_TELEPHONE LC_MEASUREMENT \
    LC_IDENTIFICATION
fi

# Remove the legacy standalone OpenCode path while preserving every other PATH entry.
_path=""
IFS=: read -ra _path_entries <<<"$PATH"
for _path_entry in "${_path_entries[@]}"; do
  [[ $_path_entry == "$HOME/.opencode/bin" ]] && continue
  if [[ -z $_path ]]; then
    _path="$_path_entry"
  else
    _path="$_path:$_path_entry"
  fi
done
PATH="$_path"
unset _path _path_entry _path_entries

# Append the user-level directories after the system entries so system
# binaries keep precedence: /usr/local/bin for standalone tools, then the mise
# shims and ~/.local/bin (the stowed AI tool wrappers and Herdr) in the order
# Omarchy's env-bootstrap uses. Interactive shells also get the mise install
# directories from `mise activate` in init.
case ":$PATH:" in
  *":/usr/local/bin:"*) ;;
  *) export PATH="$PATH:/usr/local/bin" ;;
esac
case ":$PATH:" in
  *":$HOME/.local/share/mise/shims:"*) ;;
  *) export PATH="$PATH:$HOME/.local/share/mise/shims" ;;
esac
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) export PATH="$PATH:$HOME/.local/bin" ;;
esac
